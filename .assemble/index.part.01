.fill{height:100%;width:0;transition:width .5s cubic-bezier(.2,.7,.3,1)}
.basis{font-size:13.5px;line-height:1.5;color:var(--muted);margin-top:10px}
.watch{display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-family:'IBM Plex Mono',monospace;
  font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--lamp);text-decoration:none;
  border:1px solid var(--edge);padding:10px 12px;border-radius:2px}
.watch:hover{border-color:var(--lamp)}
.watch b{font-weight:400;text-transform:none;letter-spacing:0;font-family:'Newsreader',serif;font-size:14px;color:#CFC8BB}
.work,.linkbox{margin-top:22px;padding-top:18px;border-top:1px dashed var(--edge)}
.work h4,.linkbox h4{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;
  text-transform:uppercase;font-weight:500;margin-bottom:8px;color:var(--frontier)}
.linkbox h4{color:var(--lamp)}
.work p,.linkbox p{font-size:15px;line-height:1.55;margin-bottom:16px;color:#CFC8BB}
.linkbox p:last-child{margin-bottom:0}
.linkto{font-style:italic;color:var(--paper)}
.strength{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase}
details.work summary{cursor:pointer;list-style:none;font-family:'IBM Plex Mono',monospace;font-size:10px;
  letter-spacing:.16em;text-transform:uppercase;color:var(--frontier);padding:2px 0}
details.work summary::-webkit-details-marker{display:none}
details.work summary::after{content:' +'}
details.work[open] summary::after{content:' –'}
details.work[open] summary{margin-bottom:14px}
.handles{list-style:none;counter-reset:h}
.handles li{counter-increment:h;position:relative;padding-left:26px;font-size:14.5px;line-height:1.5;margin-bottom:11px;color:#CFC8BB}
.handles li::before{content:counter(h);position:absolute;left:0;top:1px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--frontier)}
textarea,input[type=text],input[type=password]{width:100%;background:var(--ink);border:1px solid var(--edge);color:var(--paper);
  font-family:'Newsreader',serif;font-size:14.5px;line-height:1.5;padding:11px;border-radius:2px}
textarea{resize:vertical;min-height:74px}
.dispute{margin-top:14px}
.flagged{border-left:2px solid var(--lamp);padding-left:11px;margin-top:12px;font-size:14px;line-height:1.5;color:#CFC8BB}
.flagged .eyebrow{display:block;margin-bottom:4px;color:var(--lamp)}
.verdict,.prereq{margin-top:20px;padding-top:18px;border-top:1px dashed var(--revisit)}
.prereq{border-top-color:var(--frontier)}
.verdict h4,.prereq h4{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--revisit);font-weight:500;margin-bottom:8px}
.prereq h4{color:var(--frontier)}
.verdict p,.prereq p{font-size:15px;line-height:1.58;margin-bottom:14px;color:#CFC8BB}
.retake-note{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--lamp);margin-bottom:14px}
.rowbtns{display:flex;gap:6px;margin-top:16px;padding-bottom:24px;flex-wrap:wrap}
.rowbtns .btn{flex:1;min-width:80px}
.done-h{font-family:'Fraunces',serif;font-size:30px;line-height:1.2;margin:30px 0 10px}
.saved-item{border-bottom:1px solid var(--edge);padding:16px 0}
.saved-item .idea{font-size:17px;margin-bottom:6px}
.list{flex:1;overflow-y:auto;margin-bottom:16px}
.field{margin-bottom:18px}
.field label{display:block;margin-bottom:7px}
.field .hint{font-size:13px;color:var(--muted);line-height:1.5;margin-top:7px}
.err{border:1px solid var(--folklore);padding:14px;border-radius:2px;font-size:14px;line-height:1.5;margin-bottom:14px}
.loading{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted);letter-spacing:.06em;padding:40px 0;text-align:center}
.dots::after{content:'';animation:dots 1.4s steps(4,end) infinite}
@keyframes dots{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app">
  <header>
    <div class="hgroup"><div class="mark">Night<span>stash</span></div></div>
    <div class="hgroup"><div class="streak" id="streak"></div><button class="gear" id="gear">Setup</button></div>
  </header>

  <section class="screen on" id="s-setup">
    <div class="eyebrow">Tonight's session</div>
    <h1 class="lede">Five new, one revisit.</h1>
    <p class="sub">Each track has a depth. Say "over my head" and it drops a rung and names what you'd need first.</p>
    <div id="gapbox"></div>
    <div class="tracks" id="tracks"></div>
    <p class="legend" id="legend"></p>
    <label class="toggle"><input type="checkbox" id="fronly">
      <span>Frontier only. Every new card is an open problem with handles.</span></label>
    <label class="toggle"><input type="checkbox" id="linkon">
      <span>Look for ties to the bench. Links must name a shared mechanism or they're marked none.</span></label>
    <label class="toggle"><input type="checkbox" id="adapton">
