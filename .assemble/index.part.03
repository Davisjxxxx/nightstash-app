  try{await store.set('nightstash:v4',{threads,weights,levels,gaps,streak,lastNight,
    frontierOnly,linkMode,adapt,endpoint,apikey,picked:[...picked]});}
  catch(e){console.error('Could not save',e);}
}
function bump(t,n){if(t)weights[t]=(weights[t]||0)+n;}
function setLvl(t,n){if(t)levels[t]=Math.max(1,Math.min(4,(levels[t]||2)+n));}
function paintStreak(){$('streak').innerHTML=streak?`<b>${streak}</b> night${streak>1?'s':''}`:'first night';}
function paintPool(){const n=openThreads().length;
  $('poolnote').textContent=n?`${n} open thread${n===1?'':'s'} in rotation. One comes back tonight.`
    :`No open threads yet. Dispute a rating or flag a card to start one.`;}
function paintGaps(){
  $('gapbox').innerHTML=gaps.length
    ?`<div class="gapnote"><span class="eyebrow">Queued as groundwork</span>${gaps.slice(0,4).map(g=>esc(g.concept)).join(' &middot; ')}</div>`:'';
}
function paintTracks(){
  $('tracks').innerHTML=TRACKS.map(t=>{
    const hot=w(t)>=HOT_AT,rest=resting(t);
    return `<button class="track ${rest?'resting':''}" aria-pressed="${picked.has(t)&&!rest}" data-t="${esc(t)}"
      title="engagement ${w(t)>0?'+':''}${w(t)}, depth ${lvl(t)}">${hot||rest?'<i class="pulse"></i>':''}${esc(t)}<i class="lvl">L${lvl(t)}</i></button>`;}).join('');
  const rc=TRACKS.filter(resting).length,hc=TRACKS.filter(t=>w(t)>=HOT_AT).length;
  $('legend').innerHTML=adapt?`${hc} running hot &nbsp;/&nbsp; ${rc} resting${rc?', tap to wake':''} &nbsp;/&nbsp; L1 plainest, L4 technical`
    :`Adaptation off. All tracks stay in the deck.`;
  $('deal').disabled=[...picked].filter(t=>!resting(t)).length===0;
}
$('tracks').onclick=e=>{const b=e.target.closest('.track');if(!b)return;const t=b.dataset.t;
  if(resting(t)){weights[t]=0;picked.add(t);}else picked.has(t)?picked.delete(t):picked.add(t);
  paintTracks();persist();};
$('fronly').onchange=e=>frontierOnly=e.target.checked;
$('linkon').onchange=e=>linkMode=e.target.checked;
$('adapton').onchange=e=>{adapt=e.target.checked;paintTracks();persist();};
$('gear').onclick=()=>show('s-config');
$('save-cfg').onclick=async()=>{endpoint=$('ep').value.trim();apikey=$('ak').value.trim();
  await persist();show('s-setup');};

$('deal').onclick=async()=>{
  show('s-cards');$('stage').innerHTML=`<div class="loading dots">Dealing</div>`;$('pips').innerHTML='';
  try{
    cards=await generate([...picked].filter(t=>!resting(t)));
    const pool=openThreads();
    if(pool.length){
      const sorted=[...pool].sort((a,b)=>(a.touched||'')<(b.touched||'')?-1:1);
      const pick=sorted[Math.floor(Math.random()*Math.min(3,sorted.length))];
      cards.push({...pick.card,_revisit:true,_threadId:pick.id});
    }
    idx=0;renderCard();
  }catch(err){
    $('stage').innerHTML=`<div class="err">Couldn't reach the idea generator. ${esc(err.message||'')}</div>
      <button class="btn ghost" onclick="document.getElementById('gear').click()">Check setup</button>`;
  }
};

async function callClaude(system,user,max){
  const url=endpoint?endpoint.replace(/\/$/,''):"https://api.anthropic.com/v1/messages";
  const headers={"Content-Type":"application/json"};
  if(!endpoint&&apikey){headers["x-api-key"]=apikey;headers["anthropic-version"]="2023-06-01";
    headers["anthropic-dangerous-direct-browser-access"]="true";}
  const res=await fetch(url,{method:"POST",headers,
    body:JSON.stringify({model:"claude-sonnet-4-6",max_tokens:max||2000,system,messages:[{role:"user",content:user}]})});
  const data=await res.json();
  if(data.error) throw new Error(data.error.message||'API error');
  return data.content.filter(b=>b.type==="text").map(b=>b.text).join("");
}
const parse=t=>JSON.parse(t.replace(/```json|```/g,"").trim());

const ACCURACY=`Accuracy rules. These override interestingness and override making anything easier to read:
- Rate honestly. Split popular claims from their real underlying science instead of dismissing a whole topic.
- BIOMAGNETISM: the heart's electrical activity produces a real magnetic field measured clinically by magnetocardiography, roughly 10 to 100 picotesla at the chest, via SQUID magnetometers since the 1960s. ESTABLISHED. Any dipole has toroidal field-line topology, true of a bar magnet too, so it is not special to hearts. NOT established: that it encodes emotion, carries information between people, or is detectable at conversational distance. Dipole fields fall off as 1/r cubed and the heart's field is about a millionth of Earth's ambient field.
- QUANTUM BIOLOGY is a genuine frontier, stated precisely. Radical pair magnetoreception in cryptochrome is the strongest case, spin coherence lasting microseconds. Most biological degrees of freedom decohere in femtoseconds to picoseconds at body temperature. Entanglement cannot transmit information, by the no-communication theorem. "Observation" means decoherence via interaction, not consciousness. Never let "everything is interconnected" stand in for a mechanism.
