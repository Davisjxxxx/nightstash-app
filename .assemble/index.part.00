<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0C131C">
<link rel="manifest" href="./manifest.webmanifest">
<title>Nightstash</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Newsreader:opsz,wght@6..72,300;6..72,400&family=IBM+Plex+Mono:wght@400;500&display=swap');
:root{--ink:#0C131C;--slate:#151F2C;--edge:#243447;--lamp:#E8A33D;--paper:#EDE6D8;--muted:#7B8CA1;
  --solid:#6FC08B;--frontier:#5FB8C4;--contested:#C9A227;--folklore:#B8687E;--revisit:#A78BC4}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--ink);color:var(--paper);font-family:'Newsreader',Georgia,serif;font-weight:300;
  -webkit-font-smoothing:antialiased;display:flex;justify-content:center;padding:0 18px env(safe-area-inset-bottom)}
#app{width:100%;max-width:460px;display:flex;flex-direction:column;min-height:100vh}
.eyebrow{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
header{display:flex;align-items:baseline;justify-content:space-between;padding:26px 0 18px;gap:10px}
.mark{font-family:'Fraunces',serif;font-weight:600;font-size:19px;letter-spacing:-.01em}
.mark span{color:var(--lamp)}
.hgroup{display:flex;align-items:baseline;gap:12px}
.streak{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)}
.streak b{color:var(--lamp);font-weight:500}
.gear{background:none;border:0;color:var(--muted);font-family:'IBM Plex Mono',monospace;font-size:10px;
  letter-spacing:.14em;text-transform:uppercase;cursor:pointer;padding:4px}
.screen{display:none;flex:1;flex-direction:column}
.screen.on{display:flex}
.lede{font-family:'Fraunces',serif;font-size:27px;line-height:1.22;font-weight:400;margin:14px 0 8px}
.sub{color:var(--muted);font-size:15px;line-height:1.5;margin-bottom:20px}
.tracks{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:8px}
.track{font-family:'IBM Plex Mono',monospace;font-size:11.5px;padding:8px 12px;border:1px solid var(--edge);
  border-radius:2px;background:transparent;color:var(--muted);cursor:pointer;transition:.14s;line-height:1;
  display:flex;align-items:center;gap:7px}
.track:hover{border-color:var(--muted)}
.track[aria-pressed="true"]{background:var(--lamp);border-color:var(--lamp);color:var(--ink)}
.track .pulse{width:4px;height:4px;border-radius:50%;background:var(--solid);flex-shrink:0}
.track.resting{opacity:.42;border-style:dashed}
.track.resting .pulse{background:var(--folklore)}
.track[aria-pressed="true"] .pulse{background:var(--ink);opacity:.55}
.track .lvl{font-size:9px;opacity:.7}
.legend{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:.04em;margin-bottom:16px;line-height:1.7}
.gapnote{border-left:2px solid var(--frontier);padding-left:11px;margin-bottom:18px;font-size:13.5px;line-height:1.5;color:#CFC8BB}
.gapnote .eyebrow{display:block;margin-bottom:4px;color:var(--frontier)}
.toggle{display:flex;align-items:flex-start;gap:10px;margin-bottom:11px;cursor:pointer}
.toggle input{accent-color:var(--lamp);width:16px;height:16px;margin-top:2px;flex-shrink:0}
.toggle span{font-size:14px;color:var(--muted);line-height:1.45}
.btn{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
  width:100%;padding:15px;border:0;border-radius:2px;background:var(--lamp);color:var(--ink);cursor:pointer;transition:.14s}
.btn:disabled{background:var(--slate);color:var(--muted);cursor:not-allowed}
.btn.ghost{background:transparent;border:1px solid var(--edge);color:var(--muted)}
.btn.small{font-size:10px;padding:11px 6px;letter-spacing:.05em}
.foot{margin-top:auto;padding:20px 0;font-size:12.5px;color:var(--muted);line-height:1.55}
.progress{display:flex;gap:4px;margin:4px 0 20px}
.pip{height:2px;flex:1;background:var(--edge)}
.pip.done{background:var(--lamp)}
.pip.rev.done{background:var(--revisit)}
.card{background:var(--slate);border:1px solid var(--edge);border-radius:3px;padding:26px 24px 22px;
  display:flex;flex-direction:column;animation:rise .34s cubic-bezier(.2,.7,.3,1)}
.card.revisit{border-color:var(--revisit)}
.card.retake{border-color:var(--lamp)}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.card .topic{margin-bottom:16px;display:flex;justify-content:space-between;gap:10px}
.idea{font-family:'Fraunces',serif;font-size:23px;line-height:1.34;font-weight:400;margin-bottom:16px}
.body{font-size:16px;line-height:1.62;color:#CFC8BB}
.meter{margin-top:22px;padding-top:16px;border-top:1px solid var(--edge)}
.meter-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.tier{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase}
.bar{height:3px;background:#0C131C;overflow:hidden}
