  if(isRev&&existing&&existing.verdict)paintVerdict(existing.verdict);
  if($('det'))$('det').addEventListener('toggle',()=>{if($('det').open){touched=true;bump(c.topic,1);}});
  if($('ytl'))$('ytl').onclick=()=>{touched=true;bump(c.topic,2);};

  $('overhead').onclick=async()=>{
    touched=true;setLvl(c.topic,-1);
    $('stage').innerHTML=`<div class="loading dots">Dropping a level</div>`;
    try{
      const r=await reframe(c,true);
      if(r.prereq&&r.prereq.concept&&!gaps.some(g=>g.concept===r.prereq.concept))
        gaps.unshift({concept:r.prereq.concept,why:r.prereq.why,forCard:c.idea,date:today()});
      cards[idx]={...c,idea:r.idea,body:r.body,hook:r.hook,watch:r.watch||c.watch,_retake:true,_prereq:r.prereq};
      await persist();renderCard();
      if(r.prereq&&r.prereq.concept)
        $('verdict').innerHTML=`<div class="prereq"><h4>What you'd want first</h4>
          <p><span class="linkto">${esc(r.prereq.concept)}</span>. ${esc(r.prereq.why)}</p>
          <p class="strength" style="color:var(--frontier)">Queued for a future night</p></div>`;
    }catch(e){$('stage').innerHTML=`<div class="err">Couldn't reframe that one.</div>
      <button class="btn" onclick="next()">Next card</button>`;}
  };
  $('challenge').onclick=()=>{touched=true;const d=$('disp');d.hidden=!d.hidden;if(!d.hidden)$('note').focus();};
  $('save-note').onclick=async()=>{
    const note=$('note').value.trim();if(!note)return;
    touched=true;bump(c.topic,3);
    $('verdict').innerHTML=`<div class="loading dots" style="padding:20px 0">Refereeing</div>`;$('disp').hidden=true;
    let v=null;
    try{v=await adjudicate(c,note);}catch(e){$('verdict').innerHTML=`<div class="err">Referee unavailable. Objection saved anyway.</div>`;}
    upsertThread(c,note,v);if(v)paintVerdict(v);await persist();
  };
  if($('benchit'))$('benchit').onclick=async()=>{touched=true;bump(c.topic,3);setLvl(c.topic,1);upsertThread(c,'',null);await persist();renderCard();};
  if($('resolve'))$('resolve').onclick=async()=>{touched=true;
    const th=threads.find(x=>x.id===c._threadId);if(th){th.status='settled';th.touched=today();}
    await persist();next();};
  $('nxt').onclick=onNext;
}

async function onNext(){
  const c=cards[idx],dwell=Date.now()-cardStart,skimmed=!touched&&dwell<SKIM_MS;
  if(adapt&&skimmed&&!retakeDone&&!c._revisit){
    retakeDone=true;
    $('stage').innerHTML=`<div class="loading dots">That one didn't land. Trying a plainer angle</div>`;
    try{const r=await reframe(c,false);
      cards[idx]={...c,idea:r.idea,body:r.body,hook:r.hook,watch:r.watch||c.watch,_retake:true};
      renderCard();return;}catch(e){}
  }
  if(adapt&&!c._revisit){
    if(touched)bump(c.topic,dwell>25000?2:1);
    else if(skimmed)bump(c.topic,c._retake?-3:-1);
    else bump(c.topic,1);
  }
  next();
}
function paintVerdict(v){
  $('verdict').innerHTML=`<div class="verdict"><h4>Where you're right</h4><p>${esc(v.concede)}</p>
    <h4>Where it still doesn't follow</h4><p>${esc(v.hold)}</p>
    <h4>What would settle it</h4><p>${esc(v.settles_it)}</p>
    ${v.revised_tier?`<p class="strength" style="color:${(TIERS[v.revised_tier]||TIERS.contested).c}">
      Revised rating: ${(TIERS[v.revised_tier]||TIERS.contested).label}</p>`:''}</div>`;
}
function upsertThread(card,note,verdict){
  const clean={...card};['_revisit','_threadId','_retake','_prereq'].forEach(k=>delete clean[k]);
  let th=threads.find(x=>x.card.idea===card.idea);
  if(!th){th={id:'t'+Date.now()+Math.random().toString(36).slice(2,6),card:clean,note:'',
    status:'open',created:today(),touched:today()};threads.unshift(th);}
  if(note)th.note=th.note?th.note+'\n\n'+note:note;
  if(verdict){th.verdict=verdict;th.card.tier=verdict.revised_tier||th.card.tier;}
  th.touched=today();
}
function next(){
  idx++;
  if(idx<cards.length){renderCard();return;}
  gaps=gaps.filter(g=>!cards.some(c=>(c.idea||'').toLowerCase().includes((g.concept||'~~').toLowerCase())));
  const d=today();
  if(lastNight!==d){const y=new Date(Date.now()-864e5).toISOString().slice(0,10);
    streak=(lastNight===y)?streak+1:1;lastNight=d;}
  paintStreak();paintTracks();paintPool();paintGaps();persist();
  const o=openThreads().length,rest=TRACKS.filter(resting).length;
  $('done-sub').textContent=`${o} open thread${o===1?'':'s'} in rotation. `+
    (gaps.length?`${gaps.length} prerequisite${gaps.length===1?'':'s'} queued. `:'')+
    (rest?`${rest} track${rest===1?'':'s'} went quiet. `:'')+`Streak at ${streak}.`;
  show('s-done');
}
$('view-saved').onclick=()=>{
  const render=list=>list.map(th=>{const t=TIERS[th.card.tier]||TIERS.contested;
    return `<div class="saved-item"><div class="idea">${esc(th.card.idea)}</div>
      ${th.card.open_question?`<p class="basis" style="margin-bottom:6px">${esc(th.card.open_question)}</p>`:''}
      ${th.note?`<p class="basis" style="margin-bottom:6px;color:#CFC8BB">You: ${esc(th.note.split('\n\n')[0])}</p>`:''}
